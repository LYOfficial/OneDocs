; Simplified Chinese language file for OneDocs NSIS installer
LangString addOrReinstall ${LANG_SIMPCHINESE} "添加/重新安装组件"
LangString alreadyInstalled ${LANG_SIMPCHINESE} "已安装"
LangString alreadyInstalledLong ${LANG_SIMPCHINESE} "${PRODUCTNAME} ${VERSION} 已安装。请选择要执行的操作，然后点击下一步继续。"
LangString appRunning ${LANG_SIMPCHINESE} "{{product_name}} 正在运行！请先关闭它再试。"
LangString appRunningOkKill ${LANG_SIMPCHINESE} "{{product_name}} 正在运行！$\n点击确定关闭它。"
LangString chooseMaintenanceOption ${LANG_SIMPCHINESE} "请选择要执行的维护操作。"
LangString choowHowToInstall ${LANG_SIMPCHINESE} "请选择 ${PRODUCTNAME} 的安装方式。"
LangString createDesktop ${LANG_SIMPCHINESE} "创建桌面快捷方式"
LangString dontUninstall ${LANG_SIMPCHINESE} "不卸载"
LangString dontUninstallDowngrade ${LANG_SIMPCHINESE} "不卸载（此安装程序禁用了不卸载降级安装）"
LangString deleteAppData ${LANG_SIMPCHINESE} "删除应用数据"
LangString unableToUninstall ${LANG_SIMPCHINESE} "无法卸载"
LangString uninstallBeforeInstalling ${LANG_SIMPCHINESE} "安装前先卸载"
LangString olderOrUnknownVersionInstalled ${LANG_SIMPCHINESE} "系统中已安装旧版或未知版本"
LangString newerVersionInstalled ${LANG_SIMPCHINESE} "系统中已安装更新版本"
LangString older ${LANG_SIMPCHINESE} "旧版本"
LangString unknown ${LANG_SIMPCHINESE} "未知版本"

# OneDocs managed provider (optional)
VITE_ONEDOCS_API_URL=
VITE_ONEDOCS_API_KEY=

# SiliconFlow Embedding API Token (for RAG text embedding)
# 免费注册获取: https://cloud.siliconflow.cn
VITE_SILICONFLOW_TOKEN=

# ============================================================
# Android 签名环境变量
# ============================================================
# ⚠️ 此文件为示例模板，请复制为 .env 并填入实际值
#   cp .env.example .env
#
# 生成密钥库命令（在项目根目录执行）：
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 生成 Base64 编码（用于 GitHub Actions）：
#   Windows PowerShell:
#     [Convert]::ToBase64String([IO.File]::ReadAllBytes("upload-keystore.jks")) | Set-Content keystore_base64.txt
#   macOS/Linux:
#     base64 -i upload-keystore.jks
# ============================================================

# 密钥库文件的 Base64 编码内容（用于 CI 中还原 .jks 文件）
ANDROID_KEY_BASE64=

# 密钥别名（生成时 -alias 参数的值，默认为 upload）
ANDROID_KEY_ALIAS=upload

# 密钥库密码和密钥密码（生成时设置的密码）
ANDROID_KEY_PASSWORD=

# 密钥库文件本地路径（本地构建时使用）
ANDROID_KEYSTORE_PATH=upload-keystore.jks
